{
  "manifest_version": 3,
  "name": "FigmaCN",
  "short_name": "FigmaCN",
  "description": "自动汉化 Figma 网页界面，并在浏览器侧栏批量翻译设计文案。",
  "version": "2.2.0",
  "icons": {
    "16": "img/icon-16.png",
    "48": "img/icon-48.png",
    "128": "img/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.figma.com/*"
      ],
      "js": [
        "js/legacy-dictionary.js",
        "js/web-dictionary.js",
        "js/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": ["sidePanel", "storage"],
  "host_permissions": [
    "*://*.figma.com/*",
    "https://api.deepseek.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "action": {
    "default_title": "FigmaCN · 图层译写",
    "default_icon": "img/icon-48.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
